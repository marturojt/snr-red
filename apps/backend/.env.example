PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/snr-red-dev
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Production settings for Linux server with MongoDB local (no auth)
# NODE_ENV=production
# MONGODB_URI=mongodb://localhost:27017/snr-red-prod
# JWT_SECRET=super-secure-random-jwt-secret-32-chars-minimum
# BASE_URL=https://snr.red
# FRONTEND_URL=https://snr.red

# Rate limiting (global, per IP, applied to /api/)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Public API (/api/v1) rate limiting — per API key, not per IP
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# QR Code settings
QR_CODE_SIZE=200
QR_CODE_FORMAT=png

# Analytics retention (days)
ANALYTICS_RETENTION_DAYS=365

# IMPORTANT (production): the server refuses to start unless JWT_SECRET is a
# unique random value of >= 32 chars (not the example above) and MONGODB_URI is set.
# Generate one with:  openssl rand -hex 32
# Recommended: enable MongoDB auth and bind it to 127.0.0.1, e.g.
# MONGODB_URI=mongodb://snr_app:STRONG_PASSWORD@127.0.0.1:27017/snr-red-prod?authSource=admin
