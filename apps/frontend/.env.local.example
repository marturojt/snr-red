# Development Configuration
# NOTE: must include the /api suffix — the backend mounts its routes under /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production Configuration (usado por el script de despliegue)
# NEXT_PUBLIC_API_URL=https://api.snr.red/api
# NEXT_PUBLIC_APP_URL=https://snr.red

# Feature flags (Fase 1 = "core + API"). vCard/QR are hidden unless set to "true".
NEXT_PUBLIC_FEATURE_VCARDS=false
NEXT_PUBLIC_FEATURE_QR=false
